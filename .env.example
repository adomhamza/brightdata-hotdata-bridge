# Copy to .env and fill in. Both the `bdh` CLI and the Python library read these.
# Never commit the real .env file.

# --- Required ------------------------------------------------------------
BRIGHTDATA_API_KEY=
HOTDATA_API_KEY=
HOTDATA_WORKSPACE_ID=

# --- Optional (defaults shown) -------------------------------------------
# Target database. When neither is set, the workspace's only database is used;
# if the workspace has several, set one of these (`bdh databases` lists them).
# HOTDATA_DATABASE_ID=
# HOTDATA_DATABASE_NAME=
# Schema that tables are published into. Defaults to the database's default schema,
# or `public` when the database has none.
# HOTDATA_SCHEMA=
# Override only when targeting a non-production Hotdata environment.
# HOTDATA_HOST=https://api.hotdata.dev

# Seconds between Bright Data progress checks, and the overall wait limit.
# BDH_POLL_INTERVAL_SECONDS=10
# BDH_POLL_TIMEOUT_SECONDS=3600

# Seconds to wait for a background Hotdata load job to finish.
# BDH_LOAD_TIMEOUT_SECONDS=1800

# Where run records, downloaded snapshots and the scraper catalog cache live.
# BDH_STATE_DIR=.bdh

# Scraper catalog source and how long the cached copy stays fresh.
# BDH_CATALOG_URL=https://docs.brightdata.com/scrapers-full.json
# BDH_CATALOG_TTL_HOURS=24
